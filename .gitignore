# 密钥与本地配置
.env
.env.local

# 真实投递数据：含公司名/薪资/面试记录，属个人隐私，绝不进公开仓库
# state.json 是从看板「导出数据」得到的本地存档，只用于个人版构建与备份
data/state.json
data/applications.json
data/exports/

# 自荐信正文 data/letters.json 于 2026-09-22 起**故意提交**：
# CI 是从仓库 clone 后构建的，它不在仓库里线上就永远拿不到正文，
# 手机上也就复制不到。别再把它加回 .gitignore。
# 要出一份不带自荐信的干净版（发给招聘方看），用 build.py --no-letters。

# 构建产物（由 build.py 生成，可重新构建）
dist/

# 本地跑脚本的临时输出 —— 曾经被 git add -A 一起带进仓库
.daily.txt
.pytest_out.txt
.*_out.txt

# 可发布产物（build.py --publish 生成，CI 部署用）
dist-publish/

# PWA 端到端测试的临时服务目录
.pwa_tmp/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
